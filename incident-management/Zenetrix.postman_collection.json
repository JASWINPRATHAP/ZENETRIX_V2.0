					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Production database timeout\",\n    \"description\": \"The database is not responding to queries.\",\n    \"priority\": \"MEDIUM\"\n}"
						},
						"url": {
							"raw": "http://localhost:8080/api/incidents",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8080",
							"path": [
								"api",
								"incidents"
							]
						}
					}
				},
				{
					"name": "Get All Incidents (Paginated)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "http://localhost:8080/api/incidents?page=0&size=10&sort=createdAt,desc",
							"protocol": "http",
